    ],
    [
      "Rounded square inertia",
      "Is(b,r)=b^4/12-4*((b/2-r)^2*r^2*(1-pi/4)+(b/2-r)*r^3/3+r^4*(1/3-pi/16))"
    ],
    [
      "Tube section",
      "A=As(b,ro)-As(b-2t,ri); I=Is(b,ro)-Is(b-2t,ri)"

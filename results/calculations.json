      "M=F*L/4+q*L^2/8; Me=F*cmax*sqrt(2)"
    ],
    [
      "Beam stress",
      "sigma_b=sqrt(2)*(M+Me)/Z; sigma_a=F/Amin; VM=sqrt((sigma_b+sigma_a)^2+3*(tau_T+tau_V)^2)"
